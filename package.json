{
  "name": "@dsh-external/dsh-android-pane",
  "version": "0.2.1",
  "description": "Android 安卓设备实时画面面板：scrcpy 真机/模拟器 H.264 串流进 DSH 对话，agent 可点按操作并用截图与控件树自证，截图录屏调试证据存到电脑目录",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hoyyang/dsh-android-pane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoyyang/dsh-android-pane.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "android",
    "adb",
    "scrcpy",
    "screen-mirroring",
    "android-automation",
    "uiautomator",
    "agent-tools",
    "computer-use"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-host-directory-picker-native": ">=0.2.1-rc.2 <2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc <2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "unrun": "^0.3.1"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown",
    "test": "node scripts/check-capture.mjs && node scripts/check-input.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
